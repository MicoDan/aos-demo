# Copy to .env to override. Every value has the same default inside docker-compose.yml,
# so `docker compose up --build` works from a clean checkout without this file.

# --- System A database (owned by task-api / outbox-publisher only)
DB_A_USER=taskapp_a
DB_A_PASSWORD=change-me-a
DB_A_NAME=tasks

# --- System B database (owned by replica-consumer / replica-api only)
DB_B_USER=taskapp_b
DB_B_PASSWORD=change-me-b
DB_B_NAME=replica

# --- Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# URL the BROWSER uses; also the fixed `iss` of every token
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# URL CONTAINERS use to fetch JWKS / tokens
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Accepted `azp` (authorized party) values
ALLOWED_AZP=task-frontend,task-seeder

FRONTEND_ORIGIN=http://localhost:5173

# Host port Keycloak is published on. If you change it, change KEYCLOAK_PUBLIC_URL to match
# (e.g. KEYCLOAK_PORT=8180 + KEYCLOAK_PUBLIC_URL=http://localhost:8180).
KEYCLOAK_PORT=8080
